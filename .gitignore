# Godot 4+ specific ignores
.godot/
/android/

# temp banner/studio captures
studio_banner.png
_banner.png
_shot.png

# Node relay deps (online multiplayer server — see server.js)
node_modules/

# headless netcode QA output (scripts/nettest.ps1)
scripts/nettest_logs/

# build artifacts (the old headless-server pack is no longer used — the host
# browser is the authority now; see server.js / docs/DEPLOY_ONLINE.md)
build/

# Blender asset pipeline (tools/blender): python caches + Blender's .blend1 backups
__pycache__/
*.blend1
# per-asset preview renders are regenerated by build_sky_assets.py; only the sheets are kept
tools/blender/previews/*
!tools/blender/previews/contact_sheet.png
!tools/blender/previews/world_*.png
